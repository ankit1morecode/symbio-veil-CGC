# Optional MongoDB. Leave unset for the disclosed offline JSON journal.
# MONGODB_URI=mongodb://127.0.0.1:27017/veil
# In hosted environments, require MongoDB so missing data cannot silently fall back to ephemeral files.
# REQUIRE_MONGODB=true
# Exact frontend origins, comma-separated (the origin has no trailing slash).
# ALLOWED_ORIGINS=https://your-project.vercel.app
# Public backend origin for the Vercel frontend. Never put database credentials in VITE_ variables.
# VITE_API_BASE_URL=https://your-backend.onrender.com
PORT=4000
